#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"Aaaaaw, dat is echt schattig, maar, weet je, bots werken niet zo. Je bent te"
" menselijk voor mij! Laten we het professioneel houden ❤️"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_partner
msgid "Contact"
msgstr "Contact"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__disabled
msgid "Disabled"
msgstr "Uitgeschakeld"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_channel
msgid "Discussion Channel"
msgstr "Discussiekanaal"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
msgid "Display Name"
msgstr "Schermnaam"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_thread
msgid "Email Thread"
msgstr "E-mail discussie"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/mailbot_service.js:0
#, python-format
msgid "Enable desktop notifications to chat"
msgstr "Schakel desktop notificaties in om te chatten"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Great! 👍<br/>Now, try to <b>send an attachment</b>, like a picture of your "
"cute dog..."
msgstr ""
"Geweldig! 👍<br/>Probeer nu <b>een bijlage te versturen</b>, zoals een foto "
"van uw schattige hond..."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_ir_http
msgid "HTTP Routing"
msgstr "HTTP routing"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_channel.py:0
#, python-format
msgid ""
"Hello,<br/>TigernixERP's chat helps employees collaborate efficiently. I'm here to "
"help you discover its features.<br/><b>Try to send me an emoji :)</b>"
msgstr ""
"Hallo, <br/>TigernixERP's chat helpt medewerkers efficiënt samen te werken. Ik ben "
"hier om je te helpen de functies ervan te ontdekken.<br/> <b>Probeer me een "
"emoji te sturen :)</b>"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Hmmm..."
msgstr "Hmmm..."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "I'm afraid I don't understand. Sorry!"
msgstr "Ik begrijp het helaas niet. Sorry!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"I'm just a bot... :( You can check <a "
"href=\"https://www.tigernix.com/page/docs\">our documentation</a>) for more "
"information!"
msgstr ""
"Ik ben maar een bot ... :( Je kunt <a "
"href=\"https://www.tigernix.com/page/docs\">onze documentatie</a> raadplegen) "
"voor meer informatie!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"I'm not smart enough to answer your question.<br/>To follow my guide, ask"
msgstr ""
"Ik ben niet slim genoeg om je vraag te beantwoorden. <br/>Om mijn te helpen,"
" vraag"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
msgid "ID"
msgstr "ID"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__idle
msgid "Idle"
msgstr "Inactief"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot____last_update
msgid "Last Modified on"
msgstr "Laatst gewijzigd op"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "Mail bot"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not a cute dog, but you get it 😊<br/>To access special features, <b>start "
"your sentence with '/'</b>. Try to get help."
msgstr ""
"Geen schattige hond, maar je snapt het 😊 Om toegang te krijgen tot speciale "
"functies, start je je zin met '/'. Probeer hulp te krijgen."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not exactly. To continue the tour, send an emoji, <b>type \":)\"</b> and "
"press enter."
msgstr ""
"Niet helemaal. Om de tour te vervolgen verzend u een emoji, <b>type "
"\":)\"</b>en druk op enter."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__not_initialized
msgid "Not initialized"
msgstr "Niet geïnitialiseerd"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not sure wat you are doing. Please press / and wait for the propositions. "
"Select \"help\" and press enter"
msgstr ""
"Ik weet niet wat u aan het doen bent. Druk alstublieft : en wacht voor de "
"voorstellen. Selecteer \"help\" en druk dan op enter."

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/systray_messaging_menu.js:0
#, python-format
msgid ""
"TigernixERP will not have the permission to send native notifications on this "
"device."
msgstr ""
"TigernixERP heeft geen toegang om native berichten te versturen op dit apparaat."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__tigernixbot_state
msgid "TigernixERPBot Status"
msgstr "TigernixERPBot status"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/mailbot_service.js:0
#, python-format
msgid "TigernixERPBot has a request"
msgstr "TigernixERPBot heeft een verzoek"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_attachement
msgid "Onboarding attachement"
msgstr "Onboarding bijlage"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_command
msgid "Onboarding command"
msgstr "Onboarding commando"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "Onboarding emoji"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "Onboarding ping"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/systray_messaging_menu.js:0
#, python-format
msgid "Permission denied"
msgstr "Toegang geweigerd"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Pong."
msgstr "Pong."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...<br/>I can show you features if you write"
msgstr ""
"Sorry ik ben slaperig. Of niet! Misschien probeer ik gewoon mijn "
"onwetendheid over menselijke taal te verbergen ...<br/> Ik kan je "
"eigenschappen laten zien als je schrijft"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Sorry, I am not listening. To get someone's attention, <b>ping him</b>. "
"Write \"@odoobot\" and select me."
msgstr ""
"Sorry, ik luister niet. Als je iemands aandacht wilt trekken, moet je hem "
"<b>een ping sturen</b>. Schrijf \"@odoobot\" en selecteer mij."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "Dat is niet vriendelijk! Ik ben een bot maar heb ook gevoelens... 💔"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"To <b>send an attachment</b>, click the 📎 icon on the right, and select a "
"file."
msgstr ""
"Als u een bijlage wilt verzenden, klikt u op het pictogram 📎 aan de "
"rechterkant en selecteert u een bestand."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "To start, try to send me an emoji :)"
msgstr "Probeer mij een emoji te sturen om te starten :)"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "Users"
msgstr "Gebruikers"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Wow you are a natural!<br/>Ping someone to grab its attention with "
"@nameoftheuser. <b>Try to ping me using @TigernixERPBot</b> in a sentence."
msgstr ""
"Wow je bent een natuurlijktalent! <br/>Ping iemand om zijn aandacht te "
"trekken met @gebruikersnaam. <b>Probeer me te pingen met @TigernixERPBot </b>in een"
" zin."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Yep, I am here! 🎉 <br/>You finished the tour, you can <b>close this chat "
"window</b>. Enjoy discovering TigernixERP."
msgstr ""
"Ja, ik ben hier! 🎉 Je hebt de rondleiding voltooid,<b> je kunt dit "
"chatvenster sluiten</b>. Geniet van het ontdekken van TigernixERP."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Yep, TigernixERPBot is in the place!"
msgstr "Yep, TigernixERPBot is er klaar voor!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "fuck"
msgstr "fuck"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "help"
msgstr "help"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "i love you"
msgstr "Ik hou van je"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "love"
msgstr "liefde"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#: code:addons/mail_bot/models/mail_bot.py:0
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "start the tour"
msgstr "start de tour"
