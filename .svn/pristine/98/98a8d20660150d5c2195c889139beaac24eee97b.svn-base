#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"Aaaaaw thật dễ thương nhưng, bạn biết đấy, bot không hoạt động theo cách đó."
" Bạn quá con người đối với tôi! Hãy giữ cho nó chuyên nghiệp"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_partner
msgid "Contact"
msgstr "Danh bạ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__disabled
msgid "Disabled"
msgstr "Đã vô hiệu"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_channel
msgid "Discussion Channel"
msgstr "Kênh thảo luận"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
msgid "Display Name"
msgstr "Tên hiển thị"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_thread
msgid "Email Thread"
msgstr "Luồng Email"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/mailbot_service.js:0
#, python-format
msgid "Enable desktop notifications to chat"
msgstr "Bật thông báo trên màn hình để trò chuyện"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Great! 👍<br/>Now, try to <b>send an attachment</b>, like a picture of your "
"cute dog..."
msgstr ""
"Tuyệt quá! <br/> Bây giờ, <b>hãy thử gửi một tệp đính kèm </b>, như một bức "
"tranh về chú chó dễ thương của bạn ..."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_ir_http
msgid "HTTP Routing"
msgstr "HTTP Routing"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_channel.py:0
#, python-format
msgid ""
"Hello,<br/>TigernixERP's chat helps employees collaborate efficiently. I'm here to "
"help you discover its features.<br/><b>Try to send me an emoji :)</b>"
msgstr ""
"Xin chào, <br/> trò chuyện của TigernixERP giúp nhân viên hợp tác hiệu quả. Tôi ở "
"đây để giúp bạn khám phá các tính năng <br/> của nó. <b> Hãy thử gửi cho tôi"
" biểu tượng cảm xúc :) </b>"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Hmmm..."
msgstr "Hmmm..."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "I'm afraid I don't understand. Sorry!"
msgstr "I sợ là mình không hiểu. Rất tiếc!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"I'm just a bot... :( You can check <a "
"href=\"https://www.tigernix.com/page/docs\">our documentation</a>) for more "
"information!"
msgstr ""
"Tôi chỉ là một bot... :( Bạn có thể  kiểm tra<a "
"href=\"https://www.tigernix.com/page/docs\"> tài liệu của chúng tôi </a>) để có "
"thêm thông tin!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"I'm not smart enough to answer your question.<br/>To follow my guide, ask"
msgstr ""
"Tôi không đủ thông minh để trả lời câu hỏi của bạn. Để làm theo hướng dẫn "
"của tôi, hãy hỏi"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
msgid "ID"
msgstr "ID"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__idle
msgid "Idle"
msgstr "Rảnh rỗi"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot____last_update
msgid "Last Modified on"
msgstr "Sửa lần cuối"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "Mail Bot"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not a cute dog, but you get it 😊<br/>To access special features, <b>start "
"your sentence with '/'</b>. Try to get help."
msgstr ""
"Không phải là một con chó dễ thương, nhưng bạn có được nó 😊 <br/> Để truy "
"cập các tính năng đặc biệt, <b> hãy bắt đầu câu của bạn với '/' </b>. Hãy cố"
" gắng để được giúp đỡ."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not exactly. To continue the tour, send an emoji, <b>type \":)\"</b> and "
"press enter."
msgstr ""
"Không chính xác. Để tiếp tục chuyến tham quan, hãy gửi biểu tượng cảm xúc, "
"<b>nhập \":)\" </b> và nhấn enter."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__not_initialized
msgid "Not initialized"
msgstr "Không được khởi tạo"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not sure wat you are doing. Please press / and wait for the propositions. "
"Select \"help\" and press enter"
msgstr ""
"Không chắc chắn những gì bạn đang làm. Vui lòng nhấn / và chờ đợi các đề "
"xuất. Chọn \"trợ giúp\" và nhấn enter"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/systray_messaging_menu.js:0
#, python-format
msgid ""
"TigernixERP will not have the permission to send native notifications on this "
"device."
msgstr "Hệ thống hiện sẽ không có quyền để gửi thông báo trên thiết bị này."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__tigernixbot_state
msgid "TigernixERPBot Status"
msgstr "Trạng thái của TigernixERPBot"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/mailbot_service.js:0
#, python-format
msgid "TigernixERPBot has a request"
msgstr "TigernixERPBot có một yều cầu"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_attachement
msgid "Onboarding attachement"
msgstr "Đính kèm"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_command
msgid "Onboarding command"
msgstr "Lệnh"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "Biểu tượng cảm xúc"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "ping"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/systray_messaging_menu.js:0
#, python-format
msgid "Permission denied"
msgstr "Đã bị từ chối cấp phép"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Pong."
msgstr "Pong."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...<br/>I can show you features if you write"
msgstr ""
"Xin lỗi tôi buồn ngủ. hoặc không! Có lẽ tôi chỉ đang cố gắng che giấu sự "
"không nhận thức của mình về ngôn ngữ của con người ... <br/>Tôi có thể cho "
"bạn thấy các tính năng nếu bạn viết"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Sorry, I am not listening. To get someone's attention, <b>ping him</b>. "
"Write \"@odoobot\" and select me."
msgstr ""
"Xin lỗi, tôi không nghe. Để thu hút sự chú ý của ai đó, hãy ping anh ta. "
"Viết \"@odoobot\" và chọn tôi."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "Điều đó không tốt! Tôi là một bot nhưng tôi có cảm xúc ... 💔"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"To <b>send an attachment</b>, click the 📎 icon on the right, and select a "
"file."
msgstr ""
"Để <b>gửi một tài liệu đính kèm</b>, nhấn biểu tượng📎 phía bên phải và chọn "
"một tài liệu."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "To start, try to send me an emoji :)"
msgstr "Để bắt đầu, hãy thử gửi cho tôi một biểu tượng cảm xúc :)"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "Users"
msgstr "Người dùng"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Wow you are a natural!<br/>Ping someone to grab its attention with "
"@nameoftheuser. <b>Try to ping me using @TigernixERPBot</b> in a sentence."
msgstr ""
"Ồ, bạn thật tự nhiên! <br/> Ping ai đó để thu hút sự chú ý của nó với @tên "
"của người dùng. <b> Cố gắng ping tôi bằng cách sử dụng @TigernixERPBot </b> trong "
"một câu."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Yep, I am here! 🎉 <br/>You finished the tour, you can <b>close this chat "
"window</b>. Enjoy discovering TigernixERP."
msgstr ""
"Đúng, tôi ở đây! <br/> Bạn đã kết thúc chuyến tham quan, bạn có thể <b> đóng"
" cửa sổ trò chuyện này. </b> Thích khám phá TigernixERP."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Yep, TigernixERPBot is in the place!"
msgstr "Đúng, TigernixERPBot đang ở đây!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "fuck"
msgstr "fuck"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "help"
msgstr "giúp"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "i love you"
msgstr "i love you"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "love"
msgstr "love"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#: code:addons/mail_bot/models/mail_bot.py:0
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "start the tour"
msgstr "bắt đầu chuyến đi tham quan"
