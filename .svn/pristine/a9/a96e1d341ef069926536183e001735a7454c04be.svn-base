.tigernixerp .oe_force_bold {
  font-weight: bold !important;
}
.tigernixerp label.oe_open_balance{
    margin-right: -18px;
}
.tigernixerp label.oe_subtotal_footer_separator{
    float:right;
    width: 184px !important;
}
.tigernixerp label.oe_mini_subtotal_footer_separator{
    margin-right: -14px;
}
.tigernixerp .oe_account_total, .tigernixerp .oe_pos_total {
    margin-left: -2px;
}
.tigernixerp label.oe_real_closing_balance{
    min-width: 184px !important;
}
.tigernixerp label.oe_difference, .tigernixerp label.oe_pos_difference {
    margin-right: -10px;
    padding-left: 10px !important;
    min-width: 195px !important;
}
.tigernixerp .oe_opening_total{
  margin-right: 4px;
}

.o_payment_label{
  padding-right: 20px;
}