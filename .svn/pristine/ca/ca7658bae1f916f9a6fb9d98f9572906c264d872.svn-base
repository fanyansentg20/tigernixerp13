
.zoomtigernix {
    position: relative;

    /* 'Shrink-wrap' the element */
    display: inline-block;
    *display: inline;
    *zoom: 1;

    img {
        vertical-align: bottom;
    }
}

.zoomtigernix-flyout {
    position:absolute;
    z-index: 100;
    overflow: hidden;
    background: #FFF;
    top: 0;
    width: 100%;
    height: 100%;
    img {
        max-width: 500%;
    }
}

.zoomtigernix-hover .zoomtigernix-flyout {
    left: 0;
}

.zoomtigernix-next .zoomtigernix-flyout {
    left: 100%;
}