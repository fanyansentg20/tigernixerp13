#. openerp-web
#: code:addons/mail_bot/static/src/js/systray_messaging_menu.js:0
#, python-format
msgid "Permission denied"
msgstr "Permissão negada"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Pong."
msgstr ""

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...<br/>I can show you features if you write"
msgstr ""
"Desculpe, estou dormindo. Ou não! Talvez eu somente esteja tentando esconder"
" meu desconhecimento da linguagem humana...<br/>Eu posso mostrar a vocês os "
"recursos se você escrever"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Sorry, I am not listening. To get someone's attention, <b>ping him</b>. "
"Write \"@odoobot\" and select me."
msgstr ""
"Desculpe, Eu não estou ouvindo. para chamar a atenção de alguém, <b>use a "
"respectiva hashtag</b>. Escreva \"@odoobot\" e selecione-me."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "Isto não é legal! Eu sou um bot, mas tenho sentimentos... 💔"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"To <b>send an attachment</b>, click the 📎 icon on the right, and select a "
"file."
msgstr ""
"Para <b>enviar um anexos</b>, clique no 📎 ícone a direita e selecione um "
"arquivo."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "To start, try to send me an emoji :)"
msgstr "Para iniciar, tente enviar-me  um emoji :)"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "Users"
msgstr "Usuários"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Wow you are a natural!<br/>Ping someone to grab its attention with "
"@nameoftheuser. <b>Try to ping me using @TigernixERPBot</b> in a sentence."
msgstr ""
"Nossa! Você é tão natural!<br/>Chame alguém com a hashtag @nameoftheuser. "
"<b>Tente me chamar, usando @TigernixERPBot</b> na sentença"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Yep, I am here! 🎉 <br/>You finished the tour, you can <b>close this chat "
"window</b>. Enjoy discovering TigernixERP."
msgstr ""
"Sim, estou aqui! 🎉 <br/>Você finalizou o tour, você pode <b>fechar a janela "
"de chat</b>. Aproveite para descobrir o TigernixERP."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Yep, TigernixERPBot is in the place!"
msgstr "Sim, TigernixERPBot está no lugar!"

