msgstr "Tópico do E-mail"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/mailbot_service.js:0
#, python-format
msgid "Enable desktop notifications to chat"
msgstr "Habilitar notificações de chat no desktop"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Great! 👍<br/>Now, try to <b>send an attachment</b>, like a picture of your "
"cute dog..."
msgstr ""
"Ótimo! 👍<br/>Agora, tente <b>enviar um anexos</b>, como a foto de seu "
"cachorro fofo..."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_ir_http
msgid "HTTP Routing"
msgstr "Roteamento HTTP"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_channel.py:0
#, python-format
msgid ""
"Hello,<br/>TigernixERP's chat helps employees collaborate efficiently. I'm here to "
"help you discover its features.<br/><b>Try to send me an emoji :)</b>"
msgstr ""
"Olá,<br/>o chat do TigernixERP, ajuda os funcionários a colaborar de forma mais "
"eficiente. Eu estou aqui para ajudar você a descobrir seus recursos. "
"<br/><b>Tente enviar-me um email ou um emoji :)</b>"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "Hmmm..."
msgstr "Hmmm..."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "I'm afraid I don't understand. Sorry!"
msgstr "Eu tenho medo de não entender. Desculpe!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"I'm just a bot... :( You can check <a "
"href=\"https://www.tigernix.com/page/docs\">our documentation</a>) for more "
"information!"
msgstr ""
"Eu sou somente um  bot... pressione \":\" para checar <a "
"href=\"https://www.tigernix.com/page/docs\">nossa documentação para mais "
"informações!"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"I'm not smart enough to answer your question.<br/>To follow my guide, ask"
msgstr ""
"Eu não sou inteligente o suficiente para responder a esta questão.<br/>Para "
"seguir meu guia, pergunte"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
msgid "ID"
msgstr "ID"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__idle
msgid "Idle"
msgstr "Inativo"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot____last_update
msgid "Last Modified on"
msgstr "Última modificação em"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "Bot de email"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not a cute dog, but you get it 😊<br/>To access special features, <b>start "
"your sentence with '/'</b>. Try to get help."
msgstr ""
"Não é um cachorrinho fofo, mas vocês consegue 😊<br/>To access special "
"features, <b>iniciar sua sentença com '/'</b>. Tente conseguir ajuda."

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not exactly. To continue the tour, send an emoji, <b>type \":)\"</b> and "
"press enter."
msgstr ""
"Não exatamente. Para continuar o tour, envie um emoji, <b>digite \":)\"</b> "
"e pressione a tecla Enter."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__tigernixbot_state__not_initialized
msgid "Not initialized"
msgstr "Não inicializado"

#. module: mail_bot
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid ""
"Not sure wat you are doing. Please press / and wait for the propositions. "
"Select \"help\" and press enter"
msgstr ""
"Não tenho certeza do que você está fazendo. Pressione \"/\" e aguarde as "
"proposições. Selecione \"Ajuda\" e pressione a tecla Enter"

#. module: mail_bot
#. openerp-web
#: code:addons/mail_bot/static/src/js/systray_messaging_menu.js:0
#, python-format
msgid ""
"TigernixERP will not have the permission to send native notifications on this "
"device."
msgstr "TigernixERP não tem permissão para enviar notificações deste dispositivo."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__tigernixbot_state
