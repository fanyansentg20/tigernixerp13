<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="change_email" name="Change Email">
    <script src="https://unpkg.com/zod@3.22.4/lib/index.umd.js" />
    <xpath expr="." position="inside">
      <script type="text/javascript" src="/v13_training_portal/static/src/js/views/change_email.js" />
    </xpath>
    <t t-call="v13_training_portal.training_layout">
      <div id="changeEmailContainer"
        class="d-flex flex-fill align-items-center justify-content-center mx-4 my-5 py-5">
        <div class="card shadow-sm training-card">
          <div
            class="card-header bg-primary text-white">
            <h4 class="mb-0">Change Email</h4>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <input
                id="newEmail"
                type="email"
                name="newEmail"
                class="form-control"
                placeholder="New Email"
                oninput="onInputChange(event)"
              />

              <div id="newEmail-err" class="invalid-feedback"></div>
            </div>

            <button
              id="requestOtpBtn"
              class="btn btn-warning"
              onclick="sendEmailOtp()">
              Request OTP
            </button>

            <div class="mt-3">
              <input
                id="emailOtp"
                name="emailOtp"
                class="form-control"
                placeholder="OTP Code"
                oninput="onInputChange(event)"
              />
              <div id="emailOtp-err" class="invalid-feedback"></div>
            </div>

            <div class="mt-3">
              <!-- The reCAPTCHA widget -->
              <!-- <div class="g-recaptcha"
                data-sitekey="6LcL6qItAAAAAOBLhyZfPdKXkka9y3jvQdwjxkqV"></div> -->

              <!-- reCAPTCHA widget for development test only -->
              <div
                class="g-recaptcha"
                data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
              >
              </div>
            </div>

            <button
              id="updateEmailBtn"
              class="btn btn-success mt-3"
              onclick="changeEmail()">
              Update Email
            </button>

          </div>
        </div>
      </div>
    </t>
  </template>
</tigernix>