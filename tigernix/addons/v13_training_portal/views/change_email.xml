<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="change_email" name="Change Email">
    <script type="text/javascript" src="/v13_training_portal/static/src/js/views/change_email.js" />
    <t t-call="v13_training_portal.training_layout">
      <div id="changeEmailContainer"
        class="d-flex flex-fill align-items-center justify-content-center">
        <div class="card shadow-sm col-12 col-sm-7 col-md-6 col-lg-3 col-xxl-3">
          <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Change Email</h4>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <input
                id="newEmail"
                type="email"
                class="form-control"
                placeholder="New Email" />
            </div>

            <button
              class="btn btn-warning"
              onclick="sendEmailOtp()">
              Request OTP
            </button>

            <div class="mt-3">
              <input
                id="emailOtp"
                class="form-control"
                placeholder="OTP Code" />
            </div>

            <button
              class="btn btn-success mt-3"
              onclick="changeEmail()">
              Update Email
            </button>

          </div>
        </div>
      </div>
    </t>
  </template>
</tigernix>