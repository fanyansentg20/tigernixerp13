<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="change_password" name="Change Password">
    <script type="text/javascript" src="/v13_training_portal/static/src/js/views/change_password.js" />
    <t t-call="v13_training_portal.training_layout">
      <div id="changePasswordContainer"
        class="d-flex flex-fill align-items-center justify-content-center">
        <div class="card shadow-sm col-12 col-sm-7 col-md-6 col-lg-3 col-xxl-3">
          <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Change Password</h4>
          </div>

          <div class="card-body">

            <div class="mb-3">
              <input
                id="newPassword"
                type="password"
                class="form-control"
                placeholder="New Password" />
            </div>

            <div class="mb-3">
              <input
                id="confirmPassword"
                type="password"
                class="form-control"
                placeholder="Confirm Password" />
            </div>

            <button
              class="btn btn-warning"
              onclick="sendPasswordOtp()">
              Request OTP
            </button>

            <div class="mt-3">
              <input
                id="passwordOtp"
                class="form-control"
                placeholder="Enter OTP" />
            </div>

            <button
              class="btn btn-primary mt-3"
              onclick="changePassword()">
              Update Password
            </button>
          </div>

        </div>

      </div>
    </t>
  </template>
</tigernix>