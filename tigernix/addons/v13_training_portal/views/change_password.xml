<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="change_password" name="Change Password">
    <script src="https://unpkg.com/zod@3.22.4/lib/index.umd.js" />
    <xpath expr="." position="inside">
      <script type="text/javascript"
        src="/v13_training_portal/static/src/js/views/change_password.js" />
    </xpath>
    <t t-call="v13_training_portal.training_layout">
      <div id="changePasswordContainer"
        class="d-flex flex-fill align-items-center justify-content-center mx-4 my-5 py-5">
        <div class="card shadow-sm training-card">
          <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Change Password</h4>
          </div>

          <div class="card-body">
            <div id="newPasswordContainer" class="mb-2">
              <div class="input-group training-input-group" name="newPassword">
                <input type="password" id="newPassword" class="form-control"
                  oninput="onInputChange(event)" placeholder="New Password" required="true"
                  aria-label="Password"
                  aria-describedby="show-password-btn" />
                <div class="input-group-append">
                  <button class="btn btn-light" type="button" id="show-password-btn"
                    onclick="togglePasswordVisibility('newPassword', 'show-password-icon')">
                    <i class="bi bi-eye" id="show-password-icon"></i>
                  </button>
                </div>
              </div>
              <div id="newPassword-err" class="invalid-feedback"></div>
            </div>

            <div class="mb-3">
              <div class="text-muted"><i class="">*</i> Must contain lowercase letter</div>
              <div class="text-muted"><i class="">*</i> Must contain uppercase letter</div>
              <div class="text-muted"><i class="">*</i> Must contain number</div>
              <div class="text-muted"><i class="">*</i> Must contain special character</div>
              <div class="text-muted"><i class="">*</i> At least 6 characters</div>
            </div>

            <div class="mb-3">
              <div class="input-group training-input-group" name="confirmPassword">
                <input type="password" id="confirmPassword" class="form-control"
                  oninput="onInputChange(event)" placeholder="Confirm Password" required="true"
                  aria-label="Password"
                  aria-describedby="show-confirm-password-btn" />
                <div class="input-group-append">
                  <button class="btn btn-light" type="button" id="show-confirm-password-btn"
                    onclick="togglePasswordVisibility('confirmPassword', 'show-confirm-password-icon')">
                    <i class="bi bi-eye" id="show-confirm-password-icon"></i>
                  </button>
                </div>
              </div>
              <div id="confirmPassword-err" class="invalid-feedback"></div>
            </div>

            <button
              id="requestPasswordOtpBtn"
              class="btn btn-warning"
              onclick="sendPasswordOtp()">
              Request OTP
            </button>

            <div class="mt-3">
              <input
                id="passwordOtp"
                name="passwordOtp"
                class="form-control"
                placeholder="Enter OTP"
                oninput="onInputChange(event)"
              />
              <div id="passwordOtp-err" class="invalid-feedback"></div>
            </div>

            <div class="mt-3">
              <!-- The reCAPTCHA widget -->
              <!-- <div class="g-recaptcha"
                data-sitekey="6LcL6qItAAAAAOBLhyZfPdKXkka9y3jvQdwjxkqV"></div> -->

              <!-- reCAPTCHA widget for development test only -->
              <div
                class="g-recaptcha"
                data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
              >
              </div>
            </div>

            <button
              id="updatePasswordBtn"
              class="btn btn-primary mt-3"
              onclick="changePassword()">
              Update Password
            </button>
          </div>

        </div>

      </div>
    </t>
  </template>
</tigernix>