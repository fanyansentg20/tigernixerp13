<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="dashboard" name="Dashboard">
    <!-- Assets -->
    <xpath expr="." position="inside">
      <script type="text/javascript" src="/v13_training_portal/static/src/js/dashboard.js" />
    </xpath>
    <div class="card flex-fill">
      <div class="card-body">
        <section class="container mb32">
          <div class="row">
            <div class="col-12 text-center">
              <h2>Dashboard</h2>
              <p>Selamat datang di Training Portal.</p>
            </div>
          </div>
        </section>

        <section class="container">
          <div class="row training-row">

            <div class="col-md-4">
              <div class="card"
                style="cursor: pointer;"
                onclick="$('.list-group a[href=\'#profile\']').tab('show'); return false;">
                <div class="card-body text-center">
                  <i class="bi bi-person-lines-fill text-primary" style="font-size: 4rem;"></i>
                  <h4 class="mt-3">User Profile</h4>
                  <p>Lihat profil pengguna.</p>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="card"
                style="cursor: pointer;"
                onclick="$('.list-group a[href=\'#countries\']').tab('show'); return false;">
                <div class="card-body text-center">
                  <i class="bi bi-globe text-primary" style="font-size: 4rem;"></i>
                  <h4 class="mt-3">Countries</h4>
                  <p>Lihat daftar negara.</p>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="card"
                style="cursor: pointer;"
                onclick="$('.list-group a[href=\'#about\']').tab('show'); return false;">
                <div class="card-body text-center">
                  <i class="bi bi-info-circle text-primary" style="font-size: 3.15rem;"></i>
                  <h4 class="mt-3">About</h4>
                  <p>Informasi tentang Training Portal.</p>
                </div>
              </div>
            </div>

          </div>
        </section>
      </div>
    </div>
  </template>
</tigernix>