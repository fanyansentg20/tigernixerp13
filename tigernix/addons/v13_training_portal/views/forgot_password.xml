<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <!-- Assets -->
  <template id="forgot_password" name="Forgot Password Form">

    <!-- <link rel="stylesheet" href="https://jsdelivr.net" /> -->
    <script src="https://unpkg.com/zod@3.22.4/lib/index.umd.js" />
    <xpath expr="." position="inside">
      <script type="text/javascript"
        src="/v13_training_portal/static/src/js/views/forgot_password.js" />
    </xpath>
    <t t-call="v13_training_portal.training_layout">
      <div id="forgotPasswordContainer"
        class="d-flex flex-fill align-items-center justify-content-center mx-4 my-5 py-5">
        <div class="card shadow-sm training-card">
          <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Forgot Password</h4>
          </div>
          <div class="card-body">
            <div id="forgotPasswordAlertPlaceholder"></div>
            <form id="forgotPasswordForm" novalidate="novalidate" onsubmit="onSubmit(event)">

              <!-- Email Field -->
              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" required="true"
                  oninput="onInputChange(event)" />
                <div id="email-err" class="invalid-feedback"></div>
              </div>

              <!-- reCAPTCHA Field -->
              <div class="my-4 d-flex justify-content-center">
                <!-- The reCAPTCHA widget -->
                <!-- <div class="g-recaptcha"
                data-sitekey="6LcL6qItAAAAAOBLhyZfPdKXkka9y3jvQdwjxkqV"></div> -->

                <!-- reCAPTCHA widget for development test only -->
                <div
                  class="g-recaptcha"
                  data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
                >
                </div>
              </div>

              <!-- Submit Button -->
              <button id="forgotPasswordSubmitBtn" class="btn btn-primary w-100">Submit</button>
            </form>
          </div>
        </div>
      </div>
    </t>
    <!-- </t> -->
    <!-- </t> -->
  </template>
</tigernix>