<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="profile" name="Profile">
    <script src="https://unpkg.com/zod@3.22.4/lib/index.umd.js" />
    <xpath expr="." position="inside">
      <script type="text/javascript" src="/v13_training_portal/static/src/js/views/profile.js" />
    </xpath>
    <!-- <t t-call="v13_training_portal.training_layout"> -->
    <div id="titles"
      t-att-data-titles="json.dumps(titleObject.read(['id', 'name', 'shortcut']))" />
    <div id="userData" t-att-data-user-data="json.dumps(userData)" />
    <div class="card flex-fill">
      <div class="card-header">
        <h4>Update Profile</h4>
      </div>
      <div class="card-body">
        <div id="alert-area"></div>
        <div class="container">
          <div class="row">
            <div class="col-12 col-lg-6 mb-3">
              <label for="titleRegSelect" class="form-label">Title <span class="text-danger">*</span></label>
              <select id="titleRegSelectTarget" placeholder="Select Title..."
                autocomplete="off"></select>

              <div id="titleRegSelect-err" class="invalid-feedback"></div>
            </div>
            <div class="col-12 col-lg-6 mb-3">
              <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
              <input type="text" id="name" name="name" class="form-control"
                oninput="onInputChange(event)" />

              <div id="name-err" class="invalid-feedback"></div>
            </div>
            <div class="col-12 col-lg-6 mb-3">
              <label for="birthdate" class="form-label">Birthdate <span class="text-danger">*</span></label>
              <input type="date" id="birthdate" name="birthdate" class="form-control"
                placeholder="Select Date..."
                required="true" />
              <div id="birthdate-err" class="invalid-feedback"></div>
            </div>
            <div class="col-12 col-lg-6 mb-3">
              <label for="countrySelect" class="form-label">Country <span class="text-danger">*</span></label>
              <select id="countrySelectTarget"></select>

              <div id="countrySelect-err" class="invalid-feedback"></div>
            </div>
            <div class="col-12 col-lg-6 mb-3">
              <label for="stateSelect" class="form-label">State <span class="text-danger">*</span></label>
              <select id="stateSelectTarget"></select>

              <div id="stateSelect-err" class="invalid-feedback"></div>
            </div>
            <div id="citySelect" class="col-12 col-lg-6 mb-3">
              <label for="citySelect" class="form-label">City <span class="text-danger">*</span></label>
              <select id="citySelectTarget"></select>
              <div id="citySelect-err" class="invalid-feedback"></div>
            </div>
            <div id="mobilePhone" class="col-12 col-lg-6 mb-3">
              <label for="mobile">Mobile <span class="text-danger">*</span></label>
              <div class="input-group mb-3">
                <div class="input-group-prepend">
                  <span class="input-group-text" id="mobileCode"></span>
                </div>
                <input type="text" class="form-control" id="mobile" aria-describedby="basic-addon3" />
                <div id="mobile-err" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="col-12 col-lg-6 mb-3"></div>
            <div class="col-12 col-lg-6 mb-3">
              <div class="mb-4">
                <!-- The reCAPTCHA widget -->
                <!-- <div class="g-recaptcha"
                data-sitekey="6LcL6qItAAAAAOBLhyZfPdKXkka9y3jvQdwjxkqV"></div> -->

                <!-- reCAPTCHA widget for development test only -->
                <div
                  class="g-recaptcha"
                  data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
                >
                </div>
              </div>
              <button
                id="saveProfileBtn"
                type="submit"
                class="btn btn-primary w-50 align-self-end"
                onclick="updateProfile()">
                Save Profile
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- </t> -->
  </template>
</tigernix>