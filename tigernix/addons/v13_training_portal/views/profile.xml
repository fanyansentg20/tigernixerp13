<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="profile" name="Profile">
    <script type="text/javascript" src="/v13_training_portal/static/src/js/views/profile.js" />
    <!-- <t t-call="v13_training_portal.training_layout"> -->
    <div class="card flex-fill">
      <div class="card-header">
        <h4>Update Profile</h4>
      </div>
      <div class="card-body">
        <div id="alert-area"></div>
        <form id="profileForm" class="d-flex flex-column"
          onsubmit="updateProfile(event)">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" id="name" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" id="email" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">Phone</label>
            <input type="text" id="phone" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">Mobile</label>
            <input type="text" id="mobile" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">City</label>
            <input type="text" id="city" class="form-control" />
          </div>
          <button
            type="submit" class="btn btn-primary w-25 align-self-end" onclick="sendProfileOtp()">
            Request OTP
          </button>
        </form>
        <hr />
        <div class="mt-3">
          <label class="form-label bold">OTP Code</label>
          <input
            id="profileOtp"
            class="form-control" />
          <button
            class="btn btn-primary mt-3"
            onclick="saveProfile()">
            Verify OTP &amp; Save
          </button>
        </div>
      </div>

    </div>

    <!-- </t> -->
  </template>
</tigernix>