<?xml version="1.0" encoding="utf-8"?>
<tigernix>
  <template id="users" name="Users">
    <script type="text/javascript" src="/v13_training_portal/static/src/js/views/users.js" />

    <div class="card flex-fill">
      <div class="card-body d-flex flex-column justify-content-between">
        <div class="d-flex flex-row justify-content-between">
          <h3>Users</h3>
          <input type="email" class="form-control w-50" id="searchUsersInput"
            placeholder="Search Users" oninput="searchUsers(event)" />
        </div>

        <div id="usersTable" style="height: 85%"></div>

      </div>
    </div>
  </template>
</tigernix>